{
  "expo": {
    "name": "Nearsy",
    "slug": "nearsy-android",
    "scheme": "nearsy",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "../../packages/shared/src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../../packages/shared/src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.nearsy.app",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "../../packages/shared/src/assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "notification": {
      "icon": "../../packages/shared/src/assets/notification-icon.png",
      "color": "#3B5A85"
    },
    "plugins": [
      "./plugins/withAndroidGradleAutolinkingFix",
      "@react-native-firebase/app",
      "expo-dev-client",
      "expo-image-picker",
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "react-native-edge-to-edge"
    ],
    "extra": {
      "eas": {
        "projectId": "fc7412fb-e1b4-4d5f-93e8-8b6dbcd732e9"
      }
    },
    "owner": "godie.hurtado"
  }
}
