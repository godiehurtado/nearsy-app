{
  "expo": {
    "name": "Nearsy",
    "slug": "nearsy-ios",
    "scheme": "nearsy",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "../../packages/shared/src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../../packages/shared/src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.nearsy.app.client",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "4",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "deviceFamily": [
        "iphone"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nearsy uses your location to show nearby people while you are using the app.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Nearsy uses your location in the background, only when your visibility is ON.",
        "NSLocationAlwaysUsageDescription": "Nearsy uses your location in the background only when you enable visibility so nearby users can discover you.",
        "NSPhotoLibraryUsageDescription": "Nearsy needs access to your photo library so you can upload profile and gallery photos that will be visible on your profile.",
        "NSCameraUsageDescription": "Nearsy uses the camera so you can take profile or gallery photos directly within the app.",
        "NSContactsUsageDescription": "Nearsy uses your contacts to help you discover people you may know who are already using the app. Contact data is securely processed and only used to suggest connections.",
        "NSPhotoLibraryAddUsageDescription": "Nearsy needs permission to save photos generated or edited in the app to your photo library.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "notification": {
      "icon": "../../packages/shared/src/assets/notification-icon.png",
      "color": "#3B5A85"
    },
    "plugins": [
      "expo-dev-client",
      "expo-image-picker",
      [
        "expo-location",
        {
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-apple-authentication"
    ],
    "extra": {
      "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production",
      "EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION": "us-central1",
      "EXPO_PUBLIC_FIREBASE_API_KEY": "AIzaSyBv7UEL1aDLKIZRBnLZ2kuEitHmikhmqfA",
      "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN": "nearsy-pj.firebaseapp.com",
      "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "nearsy-pj",
      "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET": "nearsy-pj.firebasestorage.app",
      "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "557470198780",
      "EXPO_PUBLIC_FIREBASE_APP_ID": "1:557470198780:web:05fe20ad2e594dc0596079",
      "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "557470198780-8ls8o304sfcf8va409va90o6rar3vc5a.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "557470198780-ttslt825t6lmoma0d8e9nce1q6l1tm8c.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.557470198780-ttslt825t6lmoma0d8e9nce1q6l1tm8c",
      "EXPO_PUBLIC_LINKEDIN_AUTH_ENABLED": "true",
      "eas": {
        "projectId": "06702f76-5fb1-4426-a1f9-df42b4491c63"
      }
    },
    "owner": "godie.hurtado",
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.nearsy.app.ios"
    }
  }
}
