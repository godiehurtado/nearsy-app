{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "development",
        "EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION": "us-central1"
      }
    },
    "preview": {
      "distribution": "internal",
      "node": "22.23.4",
      "developmentClient": false,
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production",
        "EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION": "us-central1"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production"
      }
    },
    "diag-testflight": {
      "distribution": "store",
      "node": "22.23.4",
      "developmentClient": false,
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production",
        "EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION": "us-central1"
      }
    }
  },
  "submit": {
    "production": {},
    "diag-testflight": {
      "ios": {
        "ascAppId": "6759302206"
      }
    }
  }
}
