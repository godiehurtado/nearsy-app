{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.23.4"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "development",
        "EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION": "us-central1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production",
        "NEARSY_IOS_VERSION": "2.0.10",
        "NEARSY_IOS_BUILD_NUMBER": "78"
      }
    },
    "testflight-contacts-diagnostics": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production",
        "NEARSY_CONTACTS_DIAGNOSTICS_PROFILE": "testflight-contacts-diagnostics",
        "NEARSY_CONTACTS_DIAGNOSTICS_DAYS": "7",
        "NEARSY_IOS_VERSION": "2.0.10",
        "NEARSY_IOS_BUILD_NUMBER": "76"
      }
    },
    "beta": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production",
        "EXPO_PUBLIC_POSTHOG_ENABLED": "true",
        "EXPO_PUBLIC_POSTHOG_DISTRIBUTION_CHANNEL": "beta",
        "NEARSY_IOS_VERSION": "2.0.10",
        "NEARSY_IOS_BUILD_NUMBER": "74"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6759302206"
      }
    }
  }
}
