{
  "cli": {
    "version": ">= 16.32.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.23.4"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "development",
        "EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION": "us-central1"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": false,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_NEARSY_FIREBASE_ENV": "production"
      }
    },
    "testflight-contacts-diagnostics": {
      "extends": "production",
      "env": {
        "NEARSY_CONTACTS_DIAGNOSTICS_PROFILE": "testflight-contacts-diagnostics",
        "NEARSY_CONTACTS_DIAGNOSTICS_UNTIL": ""
      }
    }
  },
  "submit": {
    "production": {}
  }
}
