# --- lo mismo que tu .gitignore ---
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo

# --- asegúrate que el lockfile SI se incluya en el tar del build ---
!package-lock.json

# --- CRITICAL: .easignore REPLACES .gitignore for EAS upload ---
# Generated Expo Android native tree must NEVER upload. If present on disk
# from local QA/dev, EAS skips prebuild and can embed a stale
# google-services.json (nearsy-dev) into production AABs.
apps/nearsy-android/android/

# Development-only Firebase config — never upload to EAS
**/google-services.nearsy-dev.json

# Local QA / forensics artifacts — never upload
.qa-j05/
