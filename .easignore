# --- lo mismo que tu .gitignore ---
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env*.local
*.tsbuildinfo

# Never upload local environment files or QA artifacts to EAS
.env.eas.*
.nearsy-eas-env-dump.tmp.json
.qa-logs/
# Stale root prebuild and any generated native Android tree of the iOS app
/android/
/apps/nearsy-ios/android/
# Generated Android native tree (gitignored): may hold a debug keystore and a
# nearsy-dev google-services.json; must never ship in any EAS upload
apps/nearsy-android/android/

# --- asegúrate que el lockfile SI se incluya en el tar del build ---
!package-lock.json
